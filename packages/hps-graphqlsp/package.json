{
  "name": "@hyperse/hps-graphqlsp",
  "version": "1.0.2",
  "homepage": "https://github.com/hyperse-io/hps",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperse-io/hps",
    "directory": "packages/hps-graphqlsp"
  },
  "author": {
    "name": "Hyperse",
    "url": "https://github.com/hyperse-io"
  },
  "type": "module",
  "license": "SEE LICENSE IN FILE 'LICENSE'",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "serve": "yarn node --import=@hyperse/ts-node/register ./tests/dev-server.ts",
    "build": "node --import @hyperse/ts-node/register ./scripts/build.ts",
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "fix-all-files": "eslint . --fix",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@armit/file-utility": "^0.3.1",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@types/graphql": "^14.5.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "eslint": "^10.12.0",
    "graphql": "^16.13.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "graphql": ">=16.13.2",
    "typescript": ">=6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
