{
  "name": "@hyperse/hps-plugin-deploy",
  "version": "1.0.1",
  "homepage": "https://github.com/hyperse-io/hps",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperse-io/hps",
    "directory": "packages/hps-plugin-deploy"
  },
  "license": "SEE LICENSE IN FILE 'LICENSE'",
  "author": {
    "name": "Hyperse",
    "url": "https://github.com/hyperse-io"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p ./tsconfig.build.json",
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "fix-all-files": "eslint . --fix",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "globby": "^16.2.4",
    "mime-types": "^3.0.2",
    "yocto-spinner": "^1.2.2"
  },
  "devDependencies": {
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@hyperse/wizard": "^1.0.7",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "eslint": "^10.12.0",
    "msw": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@hyperse/wizard": ">=1.0.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
