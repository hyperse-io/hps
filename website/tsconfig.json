{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@hyperse/hps": ["../packages/hps/dist/index.d.ts"],
      "@hyperse/hps-plugin-build": [
        "../packages/hps-plugin-build/dist/index.d.ts"
      ],
      "@hyperse/hps-plugin-deploy": [
        "../packages/hps-plugin-deploy/dist/index.d.ts"
      ],
      "@hyperse/hps-plugin-info": [
        "../packages/hps-plugin-info/dist/index.d.ts"
      ],
      "@hyperse/hps-plugin-mock": [
        "../packages/hps-plugin-mock/dist/index.d.ts"
      ],
      "@hyperse/hps-plugin-serve": [
        "../packages/hps-plugin-serve/dist/index.d.ts"
      ],
      "@hyperse/hps-plugin-update": [
        "../packages/hps-plugin-update/dist/index.d.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next-intl.d.ts",
    "next-pages.d.ts",
    "**/*.ts",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.tsx",
    "**/*.mdx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
